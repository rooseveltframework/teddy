<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <title>{{page.title}} — {{site.name}}</title>
    <meta name="description" content="{{page.description}}">
  </head>
  <body class="collection" data-theme="{{#if flags.darkMode}}dark{{else}}light{{/if}}">
    {{> _header}}
    <main>
      {{#if flags.showBanner}}
        <div class="banner">
          <div class="blurb">{{{page.blurb}}}</div>
        </div>
      {{/if}}
      <h1>{{page.heading}}</h1>
      <p class="breadcrumb">{{page.breadcrumb}}</p>
      <p class="desc">{{page.description}}</p>
      {{#if user.admin}}
        <p class="role">You have admin access.</p>
      {{else if user.editor}}
        <p class="role">You can edit the catalog.</p>
      {{else}}
        <p class="role">You have read-only access.</p>
      {{/if}}
      <ul class="products">
        {{#each products}}
          {{> _product}}
        {{/each}}
      </ul>
      <table class="recent">
        <thead>
          <tr><th>ID</th><th>Name</th><th>Department</th><th>Tenure</th><th>Status</th></tr>
        </thead>
        <tbody>
          {{#each recent}}
            <tr>
              <td>{{id}}</td>
              <td>{{name}}</td>
              <td>{{department}}</td>
              <td>{{tenure}}</td>
              <td>{{#if active}}Active{{else}}Inactive{{/if}}</td>
            </tr>
          {{/each}}
        </tbody>
      </table>
      <p class="updated">Last updated {{page.updated}}.</p>
    </main>
    {{> _footer}}
  </body>
</html>

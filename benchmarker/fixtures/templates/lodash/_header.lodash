<header class="masthead">
  <p class="brand"><%- site.name %></p>
  <p class="tagline"><%- site.tagline %></p>
  <nav>
    <ul>
      <% nav.forEach(function (item) { %>
        <li class="nav-item"><a href="<%- item.href %>" <% if (item.current) { %>aria-current="page"<% } else { %>class="plain"<% } %>><%- item.label %></a></li>
      <% }) %>
    </ul>
  </nav>
  <% if (user.loggedIn) { %>
    <p class="session"><%- user.greeting %>, <%- user.name %>.</p>
  <% } else { %>
    <p class="session">Sign in to see your orders.</p>
  <% } %>
</header>

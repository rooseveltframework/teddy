<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <title>{{page.title}} — {{site.name}}</title>
    <meta name="description" content="{{page.description}}">
  </head>
  <body class="collection" data-theme="{{#flags.darkMode}}dark{{/flags.darkMode}}{{^flags.darkMode}}light{{/flags.darkMode}}">
    {{> _header}}
    <main>
      {{#flags.showBanner}}
        <div class="banner">
          <div class="blurb">{{{page.blurb}}}</div>
        </div>
      {{/flags.showBanner}}
      <h1>{{page.heading}}</h1>
      <p class="breadcrumb">{{page.breadcrumb}}</p>
      <p class="desc">{{page.description}}</p>
      {{#user.admin}}
        <p class="role">You have admin access.</p>
      {{/user.admin}}
      {{^user.admin}}
        {{#user.editor}}
          <p class="role">You can edit the catalog.</p>
        {{/user.editor}}
        {{^user.editor}}
          <p class="role">You have read-only access.</p>
        {{/user.editor}}
      {{/user.admin}}
      <ul class="products">
        {{#products}}
          {{> _product}}
        {{/products}}
      </ul>
      <table class="recent">
        <thead>
          <tr><th>ID</th><th>Name</th><th>Department</th><th>Tenure</th><th>Status</th></tr>
        </thead>
        <tbody>
          {{#recent}}
            <tr>
              <td>{{id}}</td>
              <td>{{name}}</td>
              <td>{{department}}</td>
              <td>{{tenure}}</td>
              <td>{{#active}}Active{{/active}}{{^active}}Inactive{{/active}}</td>
            </tr>
          {{/recent}}
        </tbody>
      </table>
      <p class="updated">Last updated {{page.updated}}.</p>
    </main>
    {{> _footer}}
  </body>
</html>

<li class="product" data-id="<%= it.product.id %>">
  <h3><%= it.product.name %></h3>
  <p class="price"><%= it.product.price %></p>
  <p class="desc"><%= it.product.description %></p>
  <p class="rating"><%= it.product.rating %></p>
  <% if (it.product.inStock) { %>
    <span class="stock in">In stock</span>
  <% } else { %>
    <span class="stock out">Out of stock</span>
  <% } %>
  <ul class="tags">
    <% it.product.tags.forEach(function (tag) { %>
      <li><%= tag.label %></li>
    <% }) %>
  </ul>
</li>

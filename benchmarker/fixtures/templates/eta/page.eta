<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <title><%= it.page.title %> — <%= it.site.name %></title>
    <meta name="description" content="<%= it.page.description %>">
  </head>
  <body class="collection" data-theme="<%= it.flags.darkMode ? 'dark' : 'light' %>">
    <%~ include("@_header", it) %>
    <main>
      <% if (it.flags.showBanner) { %>
        <div class="banner">
          <div class="blurb"><%~ it.page.blurb %></div>
        </div>
      <% } %>
      <h1><%= it.page.heading %></h1>
      <p class="breadcrumb"><%= it.page.breadcrumb %></p>
      <p class="desc"><%= it.page.description %></p>
      <% if (it.user.admin) { %>
        <p class="role">You have admin access.</p>
      <% } else if (it.user.editor) { %>
        <p class="role">You can edit the catalog.</p>
      <% } else { %>
        <p class="role">You have read-only access.</p>
      <% } %>
      <ul class="products">
        <% it.products.forEach(function (product) { %>
          <%~ include("@_product", { ...it, product }) %>
        <% }) %>
      </ul>
      <table class="recent">
        <thead>
          <tr><th>ID</th><th>Name</th><th>Department</th><th>Tenure</th><th>Status</th></tr>
        </thead>
        <tbody>
          <% it.recent.forEach(function (row) { %>
            <tr>
              <td><%= row.id %></td>
              <td><%= row.name %></td>
              <td><%= row.department %></td>
              <td><%= row.tenure %></td>
              <td><% if (row.active) { %>Active<% } else { %>Inactive<% } %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
      <p class="updated">Last updated <%= it.page.updated %>.</p>
    </main>
    <%~ include("@_footer", it) %>
  </body>
</html>

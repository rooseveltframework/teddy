<header class="masthead">
  <p class="brand">${input.site.name}</p>
  <p class="tagline">${input.site.tagline}</p>
  <nav>
    <ul>
      <for|item| of=input.nav>
        <li class="nav-item"><a href=item.href aria-current=item.current ? 'page' : undefined class=item.current ? undefined : 'plain'>${item.label}</a></li>
      </for>
    </ul>
  </nav>
  <if=input.user.loggedIn>
    <p class="session">${input.user.greeting}, ${input.user.name}.</p>
  </if>
  <else>
    <p class="session">Sign in to see your orders.</p>
  </else>
</header>

<table class="roster">
  <thead>
    <tr><th>ID</th><th>Name</th><th>Email</th><th>Department</th><th>Title</th><th>Tenure</th><th>Status</th></tr>
  </thead>
  <tbody>
    <for|row| of=input.rows>
      <tr>
        <td>${row.id}</td>
        <td>${row.name}</td>
        <td>${row.email}</td>
        <td>${row.department}</td>
        <td>${row.title}</td>
        <td>${row.tenure}</td>
        <td>${row.active ? 'Active' : 'Inactive'}</td>
      </tr>
    </for>
  </tbody>
</table>

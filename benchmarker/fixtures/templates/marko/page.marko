import masthead from "./_header.marko"
import productCard from "./_product.marko"
import siteFooter from "./_footer.marko"
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <title>${input.page.title} — ${input.site.name}</title>
    <meta name="description" content=input.page.description>
  </head>
  <body class="collection" data-theme=input.flags.darkMode ? 'dark' : 'light'>
    <${masthead} ...input/>
    <main>
      <if=input.flags.showBanner>
        <div class="banner">
          <div class="blurb">$!{input.page.blurb}</div>
        </div>
      </if>
      <h1>${input.page.heading}</h1>
      <p class="breadcrumb">${input.page.breadcrumb}</p>
      <p class="desc">${input.page.description}</p>
      <if=input.user.admin>
        <p class="role">You have admin access.</p>
      </if>
      <else if=input.user.editor>
        <p class="role">You can edit the catalog.</p>
      </else>
      <else>
        <p class="role">You have read-only access.</p>
      </else>
      <ul class="products">
        <for|product| of=input.products>
          <${productCard} product=product/>
        </for>
      </ul>
      <table class="recent">
        <thead>
          <tr><th>ID</th><th>Name</th><th>Department</th><th>Tenure</th><th>Status</th></tr>
        </thead>
        <tbody>
          <for|row| of=input.recent>
            <tr>
              <td>${row.id}</td>
              <td>${row.name}</td>
              <td>${row.department}</td>
              <td>${row.tenure}</td>
              <td>${row.active ? 'Active' : 'Inactive'}</td>
            </tr>
          </for>
        </tbody>
      </table>
      <p class="updated">Last updated ${input.page.updated}.</p>
    </main>
    <${siteFooter} ...input/>
  </body>
</html>
